{
  "name": "goat-pay-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --config artifacts/goat-pay/vite.config.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --build",
    "lint": "tsc --build"
  },
  "dependencies": {
    "express": "^5.2.1",
    "vite": "^7.3.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "esbuild": "^0.27.3",
    "prettier": "^3.8.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
